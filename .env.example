# Dane publicznej aplikacji Microsoft Entra używanej do OAuth2 SMTP.
SMTP_CLIENT_ID=00000000-0000-0000-0000-000000000000
SMTP_AUTHORITY=https://login.microsoftonline.com/common
SMTP_EMAIL=sender@example.com

# Odstępy między kontami i przed jednorazową ponowną próbą (sekundy).
LIBRUS_ACCOUNT_DELAY=10
LIBRUS_RETRY_DELAY=10

# Hasła wskazane w librus_konta.json. Plik env musi mieć prawa 600.
LIBRUS_PASSWORD_1=replace-me
